# Use a lightweight Python image
FROM python:3.11.8-slim

# Set working directory
WORKDIR /app

# Install Linux system dependencies required by OpenCV
# (Updated for Debian Bookworm/Trixie compatibility)
RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Copy the main requirements file (includes ultralytics, opencv, lapx)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the entire project
COPY . .

# Command to start the Edge AI orchestrator
CMD ["python", "src/edge_vision/run_store.py"]